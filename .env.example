# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# Everything here is optional: with no DATABASE_URL the editor still works in
# full, it just has no user system and no templates beyond the blank canvas.

# ---------------------------------------------------------------------------
# Database — Neon Postgres
# ---------------------------------------------------------------------------

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Direct connection (no "-pooler"). Used by migrations, which cannot run over
# the connection pooler.
# postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Auth — Better Auth
# ---------------------------------------------------------------------------

# Secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin Better Auth issues OAuth callbacks against. Must match the address the
# browser actually uses, or the session cookie will not stick.
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3009

# Comma-separated origins allowed to call the auth API.
TRUSTED_ORIGINS=http://localhost:3009

# ---------------------------------------------------------------------------
# Google OAuth — optional
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI: <origin>/api/auth/callback/google
# Leave both empty to hide the Google button; email + password still works.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
