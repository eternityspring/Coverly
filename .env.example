# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# On Vercel, set the same names under Project Settings > Environment Variables;
# the Neon marketplace integration injects them into the project automatically.

# Neon Postgres — pooled connection string. Used by the app at runtime.
# postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Neon Postgres — direct (unpooled) connection string. Used by migrations,
# which cannot run over the connection pooler.
# postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL_UNPOOLED=

# Better Auth — secret used to sign sessions. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32

# Public origin Better Auth issues OAuth callbacks against.
NUXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3009

# Comma-separated origins allowed to call the auth API.
TRUSTED_ORIGINS=http://localhost:3009

# Google OAuth — Google Cloud Console > Credentials > OAuth client ID.
# Leave empty to hide the Google button; email + password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
